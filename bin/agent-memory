#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HARNESS="$ROOT/bin/agent-harness"

usage() {
  cat <<'USAGE'
agent-memory is a legacy compatibility shim.

Use instead:
  agent-harness memory start
  agent-harness memory status
  agent-harness memory stop
  agent-harness memory restart
  agent-harness memory logs
  agent-harness memory viewer
  agent-harness memory doctor
  agent-harness memory upgrade

Recall/save operations are exposed directly through the agentmemory MCP tools
(memory_smart_search, memory_recall, memory_save, memory_lesson_save).
USAGE
}

case "${1:-help}" in
  start|status|stop|restart|logs|viewer|open|doctor|upgrade)
    exec "$HARNESS" memory "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "agent-memory '$1' is no longer supported by the harness." >&2
    usage >&2
    exit 2
    ;;
esac
