#!/usr/bin/env bash
set -euo pipefail

PACKAGE="@agentmemory/agentmemory@latest"

usage() {
  cat <<'USAGE'
agent-memory is a legacy compatibility shim.

Use instead:
  agent-harness memory status
  agent-harness memory doctor
  agent-harness memory stop
  agent-harness memory upgrade

Recall/save operations are now exposed directly through the agentmemory MCP tools
(memory_smart_search, memory_recall, memory_save, memory_lesson_save).
USAGE
}

case "${1:-help}" in
  status|doctor|stop|upgrade)
    command -v npx >/dev/null 2>&1 || { echo "npx is required" >&2; exit 127; }
    exec npx -y "$PACKAGE" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "agent-memory '$1' is no longer supported by the harness." >&2
    usage >&2
    exit 2
    ;;
esac
