#!/usr/bin/env bash
set -euo pipefail

HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATES="$HARNESS_ROOT/templates"
VERSION_FILE="$HARNESS_ROOT/VERSION"
SETUP_DIR="$HARNESS_ROOT/scripts/setup"
MANAGED_HASHES_FILE="$TEMPLATES/managed-template-hashes.tsv"
PREVIOUS_TEMPLATES_ROOT="${AGENT_HARNESS_PREVIOUS_TEMPLATES:-}"

COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

TARGET="."
YES=0
CORE_ONLY=0
SKIP_ORCA=0
SKIP_PONYTAIL=1
SKIP_AGENTMEMORY=1
NONINTERACTIVE="${AGENT_HARNESS_NONINTERACTIVE:-0}"

log() { printf '%s\n' "$*"; }
warn() { printf 'WARN    %s\n' "$*" >&2; }
ok() { printf 'OK      %s\n' "$*"; }

usage() {
  cat <<'USAGE'
agent-harness init [path]
agent-harness ready [path] [options]
agent-harness doctor [path]
agent-harness version
agent-harness orca <path|status|open|setup|update|guide|doctor>
agent-harness route --difficulty <trivial|easy|moderate|hard|critical> --domain <name> [--config path --usage path]
agent-harness chatgpt-web (retired; compatibility error)
agent-harness memory <start|status|stop|restart|logs|viewer|data-dir|doctor|upgrade> [...]

ready options:
  --yes
  --core-only
  --skip-orca
  --with-ponytail
  --with-agentmemory
  --skip-ponytail (legacy)
  --skip-chatgpt-web (legacy no-op)
  --skip-agentmemory (legacy)
  --non-interactive
USAGE
}

parse_target_and_flags() {
  local first=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES=1 ;;
      --core-only) CORE_ONLY=1 ;;
      --skip-orca) SKIP_ORCA=1 ;;
      --with-ponytail) SKIP_PONYTAIL=0 ;;
      --with-agentmemory) SKIP_AGENTMEMORY=0 ;;
      --skip-ponytail) SKIP_PONYTAIL=1 ;;
      --skip-chatgpt-web) warn 'Codex Web GPT integration was retired; this flag is now a no-op' ;;
      --skip-agentmemory|--skip-memory) SKIP_AGENTMEMORY=1 ;;
      --non-interactive) NONINTERACTIVE=1 ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "Unknown option: $1" >&2; exit 2 ;;
      *)
        if [[ "$first" -eq 1 ]]; then TARGET="$1"; first=0
        else echo "Unexpected argument: $1" >&2; exit 2
        fi
        ;;
    esac
    shift
  done
}

confirm() {
  local prompt="$1"
  local default_yes="${2:-0}"
  if [[ "$YES" -eq 1 ]]; then return 0; fi
  if [[ "$NONINTERACTIVE" -eq 1 || ! -t 0 ]]; then return 1; fi
  local answer
  if [[ "$default_yes" -eq 1 ]]; then
    read -r -p "$prompt [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]
  else
    read -r -p "$prompt [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]]
  fi
}

git_blob_hash() {
  git hash-object "$1" 2>/dev/null || true
}

known_managed_hash() {
  local rel="$1" hash="$2"
  [[ -f "$MANAGED_HASHES_FILE" ]] || return 1
  awk -F '\t' -v rel="$rel" -v hash="$hash" '
    $1 == rel && $2 == hash { found = 1 }
    END { exit(found ? 0 : 1) }
  ' "$MANAGED_HASHES_FILE"
}

matches_previous_template() {
  local rel="$1" hash="$2"
  [[ -n "$PREVIOUS_TEMPLATES_ROOT" ]] || return 1
  local previous="$PREVIOUS_TEMPLATES_ROOT/$rel"
  [[ -f "$previous" ]] || return 1
  [[ "$(git_blob_hash "$previous")" == "$hash" ]]
}

sync_managed_template() {
  local rel="$1"
  local src="$TEMPLATES/$rel"
  local dst="$TARGET/$rel"

  if [[ ! -f "$src" ]]; then
    warn "Managed template missing from harness: $rel"
    return 1
  fi

  if [[ ! -e "$dst" && ! -L "$dst" ]]; then
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    echo "CREATE  $dst"
    return 0
  fi

  if [[ ! -f "$dst" ]]; then
    echo "KEEP    $dst (not a regular file)"
    return 0
  fi

  local current_hash template_hash safe_migrate=0
  current_hash="$(git_blob_hash "$dst")"
  template_hash="$(git_blob_hash "$src")"

  if [[ -n "$current_hash" && "$current_hash" == "$template_hash" ]]; then
    echo "KEEP    $dst"
    return 0
  fi

  if [[ -n "$current_hash" ]] && known_managed_hash "$rel" "$current_hash"; then
    safe_migrate=1
  elif [[ -n "$current_hash" ]] && matches_previous_template "$rel" "$current_hash"; then
    safe_migrate=1
  fi

  if [[ "$safe_migrate" -eq 1 ]]; then
    cp "$src" "$dst"
    echo "MIGRATE $dst (untouched managed template)"
  else
    echo "KEEP    $dst (modified/project-owned)"
  fi
}

remove_if_unchanged_hash() {
  local dst="$1" expected_hash="$2"
  if [[ -f "$dst" ]] && [[ "$(git hash-object "$dst" 2>/dev/null || true)" == "$expected_hash" ]]; then
    rm -f "$dst"
    echo "REMOVE  $dst (obsolete generated file)"
    rmdir "$(dirname "$dst")" 2>/dev/null || true
  fi
}

remove_generated_orchestrator_doc() {
  local dst="$TARGET/docs/agent-orchestrator.md" hash
  for hash in \
    25d3eac348f367c261a74cb381a276afe9066694 \
    5c5a38f6a330c1ac22055ab2c5bc37a92450e2b1 \
    3727166cebee784d9b50ce679ee9a7fc0f059a7a \
    bd883e3adfb2b0173c482ddf3e5b69a97718d74b \
    b76b8c4dcb6f05ea5f09a3c59805f14d9502f885 \
    2109e8a976d18cf10343e77cb708c63ec1e0f944 \
    9eecbcd78dae935f99627026c9a36698455402a1 \
    7536e45d9a3a2759b3235dc51ba0f490e3f4c128; do
    if [[ -f "$dst" ]] && [[ "$(git hash-object "$dst" 2>/dev/null || true)" == "$hash" ]]; then
      rm -f "$dst"
      echo "REMOVE  $dst (orchestration policy moved to skills)"
      rmdir "$(dirname "$dst")" 2>/dev/null || true
      return
    fi
  done
}

retire_generated_skill() {
  local rel=".agents/skills/$1/SKILL.md"
  local dst="$TARGET/$rel"
  [[ -f "$dst" && ! -L "$dst" ]] || return 0

  local current_hash
  current_hash="$(git_blob_hash "$dst")"
  if [[ -n "$current_hash" ]] && {
       known_managed_hash "$rel" "$current_hash" ||
       matches_previous_template "$rel" "$current_hash"
     }; then
    rm -f "$dst"
    echo "REMOVE  $dst (untouched obsolete harness shim)"
    rmdir "$(dirname "$dst")" 2>/dev/null || true
  else
    echo "KEEP    $dst (project-owned/customized; review manually)"
  fi
}

resolve_target() {
  mkdir -p "$TARGET"
  TARGET="$(cd "$TARGET" && pwd)"
}

init_harness() {
  resolve_target
  [[ -d "$TARGET/.git" ]] || warn "$TARGET does not appear to be a Git repository."
  log "Installing agent harness into: $TARGET"
  log ""

  sync_managed_template "AGENTS.md"

  # Orca and integration plugins already provide these generic capabilities.
  # Retire only files proven to be untouched harness-generated shims.
  local skill
  for skill in repository-orchestrator repo-skill-bootstrap skill-discovery skill-maintenance shared-memory; do
    retire_generated_skill "$skill"
  done

  remove_if_unchanged_hash "$TARGET/.github/ISSUE_TEMPLATE/agent-task.md" "1a7563227f79eb2edd6ecb83ad4fd38fbadcaf35"
  remove_if_unchanged_hash "$TARGET/.github/pull_request_template.md" "180a428ed4da1e5fc621e8d86ddd6270f50e62e3"
  remove_if_unchanged_hash "$TARGET/scripts/agents/create-worktree.sh" "7a87ca8fc3505b4c5ccfd535bca6a81d216482f6"
  remove_generated_orchestrator_doc

  if [[ -f "$TARGET/scripts/agents/agent-memory" ]] && grep -qF "TencentDB Agent Memory" "$TARGET/scripts/agents/agent-memory"; then
    rm -f "$TARGET/scripts/agents/agent-memory"
    echo "REMOVE  $TARGET/scripts/agents/agent-memory (legacy Tencent helper)"
  fi
  rmdir "$TARGET/scripts/agents" 2>/dev/null || true

  log ""
  log "Harness files installed."
}

run_setup_script() {
  local script="$1"; shift
  [[ -f "$SETUP_DIR/$script" ]] || { warn "Missing setup helper: $SETUP_DIR/$script"; return 1; }
  bash "$SETUP_DIR/$script" "$@"
}

node_major() {
  command -v node >/dev/null 2>&1 || return 1
  node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null
}

ready_harness() {
  parse_target_and_flags "$@"
  init_harness

  if [[ "$CORE_ONLY" -eq 1 ]]; then
    SKIP_ORCA=1; SKIP_PONYTAIL=1; SKIP_AGENTMEMORY=1
  fi

  log ""
  log "== Machine capability detection =="
  command -v git >/dev/null 2>&1 && ok git || warn "git not found"
  command -v curl >/dev/null 2>&1 && ok curl || warn "curl not found"
  log 'Agent discovery and supported models are managed by Orca Settings -> Agents.'
  log 'Any supported CLI agent can be the parent or worker; no Codex/Antigravity requirement.'

  local orca_path=""
  orca_path="$(run_setup_script orca-control.sh path 2>/dev/null || true)"
  if [[ -n "$orca_path" ]]; then
    ok "Orca CLI detected: $orca_path"
    if [[ "$SKIP_ORCA" -eq 0 ]]; then
      run_setup_script orca-control.sh setup || warn "Orca skill setup needs attention"
    fi
  else
    warn "Orca CLI not detected. Install Orca from https://www.onorca.dev/docs/install and register its CLI."
  fi

  if command -v node >/dev/null 2>&1 && command -v npx >/dev/null 2>&1 && [[ "$(node_major || echo 0)" -ge 20 ]]; then
    ok "Node $(node -v) + npx"
  else
    warn "Node.js 20+ with npx is required for agentmemory"
  fi

  log ""
  if [[ "$SKIP_PONYTAIL" -eq 0 ]]; then
    if confirm "Install/update Ponytail for supported coding agents?" 0; then
      AGENT_HARNESS_NONINTERACTIVE="$NONINTERACTIVE" run_setup_script install-ponytail.sh || warn "Ponytail setup had warnings"
    else warn "Ponytail setup skipped"; fi
  fi


  if [[ "$SKIP_AGENTMEMORY" -eq 0 ]]; then
    if [[ "$(node_major || echo 0)" -ge 20 ]] && command -v npx >/dev/null 2>&1; then
      if confirm "Set up keyless local agentmemory (no API key)?" 1; then
        AGENT_HARNESS_NONINTERACTIVE="$NONINTERACTIVE" run_setup_script install-agentmemory.sh || warn "agentmemory setup needs attention"
      else warn "agentmemory setup skipped"; fi
    else
      warn "Skipping agentmemory because Node.js 20+ with npx is unavailable"
    fi
  fi

  log ""
  doctor_harness "$TARGET" || true

  cat <<'NEXT'

== Next steps ==

Open Orca, select the repository, and choose any installed agent in Settings -> Agents.
For trivial/easy work, act in the current session. For complex tasks, use the
version-matched Orca orchestration skill and its Runs/worktrees/decision gates.

Before dispatching a worker, inspect Orca Usage for the active account and model pool.
If you want an advisory machine-readable ranking, use 'agent-harness route --help'
with your own capability profiles and a fresh usage snapshot. The harness never
assumes access to a live quota API or automatically spends provider quotas.
NEXT
}

doctor_harness() {
  TARGET="${1:-$TARGET}"
  resolve_target
  local failed=0
  check() {
    if [[ -e "$TARGET/$1" ]]; then echo "OK      $1"; else echo "MISSING $1"; failed=1; fi
  }

  check AGENTS.md
  log "INFO    Generic Orca/Ponytail/agentmemory skills are managed by their upstream packages."


  log ""
  log "External readiness (informational):"
  log 'Use Orca Settings -> Agents to inspect available CLI agents and models.'

  if run_setup_script orca-control.sh path >/dev/null 2>&1; then
    run_setup_script orca-control.sh guide >/dev/null 2>&1 && ok "Orca orchestration guide available" || warn "Orca orchestration skill missing; run 'agent-harness orca setup'"
    run_setup_script orca-control.sh status >/dev/null 2>&1 && ok "Orca runtime reachable" || warn "Orca runtime not reachable; run 'agent-harness orca open'"
  else
    warn "Orca CLI not found"
  fi

  if [[ "$(node_major || echo 0)" -ge 20 ]] && command -v npx >/dev/null 2>&1; then ok "Node $(node -v) + npx"; else warn "Node.js 20+ with npx not ready"; fi
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 2 http://127.0.0.1:3111/agentmemory/livez >/dev/null 2>&1; then ok "agentmemory reachable on :3111"; else warn "agentmemory not reachable on :3111 (optional)"; fi
  if [[ -f "$HOME/.codex/config.toml" ]] && grep -q '^\[mcp_servers\.agentmemory\]' "$HOME/.codex/config.toml"; then ok "agentmemory MCP configured for Codex"; fi
  return "$failed"
}

case "$COMMAND" in
  init) TARGET="${1:-.}"; init_harness ;;
  ready|setup) ready_harness "$@" ;;
  doctor) doctor_harness "${1:-.}" ;;
  version) cat "$VERSION_FILE" ;;
  orca) exec bash "$SETUP_DIR/orca-control.sh" "$@" ;;
  route)
    if ! command -v python3 >/dev/null 2>&1; then
      echo "ERROR   python3 is required for the optional advisory router." >&2
      exit 127
    fi
    exec python3 "$HARNESS_ROOT/scripts/route_agent.py" "$@"
    ;;
  chatgpt-web)
    echo "ERROR   Legacy browser bridge setup was retired. Configure a supported agent in Orca; existing machine-level installations are untouched." >&2
    exit 2
    ;;
  memory) exec bash "$SETUP_DIR/agentmemory-service.sh" "$@" ;;
  orchestrate)
    echo "ERROR   The built-in orchestrator was retired. Use Orca's installed orchestration skill." >&2
    exit 2
    ;;
  agy)
    echo "ERROR   The custom agy host runner was removed in v0.8.0. Launch Antigravity workers through Orca." >&2
    exit 2
    ;;
  help|--help|-h) usage ;;
  *) echo "Unknown command: $COMMAND" >&2; usage >&2; exit 1 ;;
esac
