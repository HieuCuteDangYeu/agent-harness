#!/usr/bin/env bash
set -euo pipefail

HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATES="$HARNESS_ROOT/templates"
VERSION_FILE="$HARNESS_ROOT/VERSION"
SETUP_DIR="$HARNESS_ROOT/scripts/setup"
AGENTMEMORY_PACKAGE="@agentmemory/agentmemory@latest"

COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

TARGET="."
YES=0
CORE_ONLY=0
SKIP_PONYTAIL=0
SKIP_CHATGPT_WEB=0
SKIP_AGENTMEMORY=0
NONINTERACTIVE="${AGENT_HARNESS_NONINTERACTIVE:-0}"

log() { printf '%s\n' "$*"; }
warn() { printf 'WARN    %s\n' "$*" >&2; }
ok() { printf 'OK      %s\n' "$*"; }

usage() {
  cat <<'USAGE'
agent-harness init [path]
agent-harness ready [path] [options]
agent-harness doctor [path]
agent-harness version
agent-harness memory <status|doctor|stop|upgrade> [...]

ready options:
  --yes                 Accept optional installer prompts.
  --core-only           Install only repository harness files; no external add-ons.
  --skip-ponytail       Do not install Ponytail.
  --skip-chatgpt-web    Do not install codex-chatgpt-web.
  --skip-agentmemory    Do not install/configure agentmemory.
  --non-interactive     Never prompt; prepare what can be done safely and print pending steps.

`ready` is the recommended one-command bootstrap for a development machine/project.
USAGE
}

parse_target_and_flags() {
  local first=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES=1 ;;
      --core-only) CORE_ONLY=1 ;;
      --skip-ponytail) SKIP_PONYTAIL=1 ;;
      --skip-chatgpt-web) SKIP_CHATGPT_WEB=1 ;;
      --skip-agentmemory|--skip-memory) SKIP_AGENTMEMORY=1 ;;
      --non-interactive) NONINTERACTIVE=1 ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "Unknown option: $1" >&2; exit 2 ;;
      *)
        if [[ "$first" -eq 1 ]]; then
          TARGET="$1"
          first=0
        else
          echo "Unexpected argument: $1" >&2
          exit 2
        fi
        ;;
    esac
    shift
  done
}

confirm() {
  local prompt="$1"
  local default_yes="${2:-0}"

  if [[ "$YES" -eq 1 ]]; then return 0; fi
  if [[ "$NONINTERACTIVE" -eq 1 || ! -t 0 ]]; then return 1; fi

  local answer
  if [[ "$default_yes" -eq 1 ]]; then
    read -r -p "$prompt [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]
  else
    read -r -p "$prompt [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]]
  fi
}

copy_if_missing() {
  local src="$1"
  local dst="$2"

  if [[ -e "$dst" ]]; then
    echo "KEEP    $dst"
    return
  fi

  mkdir -p "$(dirname "$dst")"
  cp -R "$src" "$dst"
  echo "CREATE  $dst"
}

replace_legacy_if_present() {
  local src="$1"
  local dst="$2"
  local marker="$3"

  if [[ -f "$dst" ]] && grep -qF "$marker" "$dst"; then
    cp "$src" "$dst"
    echo "MIGRATE $dst"
  fi
}

install_skill() {
  local skill="$1"
  copy_if_missing "$TEMPLATES/.agents/skills/$skill" "$TARGET/.agents/skills/$skill"
}

resolve_target() {
  mkdir -p "$TARGET"
  TARGET="$(cd "$TARGET" && pwd)"
}

init_harness() {
  resolve_target

  if [[ ! -d "$TARGET/.git" ]]; then
    warn "$TARGET does not appear to be a Git repository."
  fi

  log "Installing agent harness into: $TARGET"
  log ""

  copy_if_missing "$TEMPLATES/AGENTS.md" "$TARGET/AGENTS.md"
  install_skill "repo-skill-bootstrap"
  install_skill "skill-discovery"
  install_skill "skill-maintenance"
  install_skill "shared-memory"
  replace_legacy_if_present \
    "$TEMPLATES/.agents/skills/shared-memory/SKILL.md" \
    "$TARGET/.agents/skills/shared-memory/SKILL.md" \
    "TencentDB Agent Memory"

  copy_if_missing "$TEMPLATES/.github/ISSUE_TEMPLATE/agent-task.md" "$TARGET/.github/ISSUE_TEMPLATE/agent-task.md"
  copy_if_missing "$TEMPLATES/.github/pull_request_template.md" "$TARGET/.github/pull_request_template.md"
  copy_if_missing "$TEMPLATES/scripts/agents/create-worktree.sh" "$TARGET/scripts/agents/create-worktree.sh"
  copy_if_missing "$TEMPLATES/docs/chatgpt-orchestrator.md" "$TARGET/docs/agent-orchestrator.md"
  replace_legacy_if_present \
    "$TEMPLATES/docs/chatgpt-orchestrator.md" \
    "$TARGET/docs/agent-orchestrator.md" \
    "TencentDB Agent Memory"

  # v0.3.x installed a project-local Tencent-specific memory helper. It is no
  # longer needed because agentmemory is exposed directly through MCP.
  if [[ -f "$TARGET/scripts/agents/agent-memory" ]] && \
     grep -qF "TencentDB Agent Memory" "$TARGET/scripts/agents/agent-memory"; then
    rm -f "$TARGET/scripts/agents/agent-memory"
    echo "REMOVE  $TARGET/scripts/agents/agent-memory (legacy Tencent helper)"
  fi

  chmod +x "$TARGET/scripts/agents/create-worktree.sh"

  log ""
  log "Harness files installed."
}

run_setup_script() {
  local script="$1"
  shift
  if [[ ! -f "$SETUP_DIR/$script" ]]; then
    warn "Missing setup helper: $SETUP_DIR/$script"
    return 1
  fi
  bash "$SETUP_DIR/$script" "$@"
}

node_major() {
  command -v node >/dev/null 2>&1 || return 1
  node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null
}

ready_harness() {
  parse_target_and_flags "$@"
  init_harness

  log ""
  log "== Machine capability detection =="
  command -v git >/dev/null 2>&1 && ok "git" || warn "git not found"
  command -v curl >/dev/null 2>&1 && ok "curl" || warn "curl not found"
  command -v codex >/dev/null 2>&1 && ok "Codex detected" || warn "Codex not detected; install it separately before using Codex workflows."
  if command -v agy >/dev/null 2>&1; then
    ok "Antigravity CLI detected"
  elif command -v gemini >/dev/null 2>&1; then
    ok "Gemini CLI detected"
  else
    warn "Antigravity/Gemini CLI not detected; this is optional."
  fi

  if command -v node >/dev/null 2>&1 && command -v npx >/dev/null 2>&1; then
    major="$(node_major || echo 0)"
    if [[ "$major" -ge 20 ]]; then
      ok "Node $(node -v) + npx (agentmemory ready)"
    else
      warn "Node $(node -v) detected; agentmemory requires Node 20+."
    fi
  else
    warn "Node.js 20+ with npm/npx is required for agentmemory."
  fi

  if [[ "$CORE_ONLY" -eq 1 ]]; then
    SKIP_PONYTAIL=1
    SKIP_CHATGPT_WEB=1
    SKIP_AGENTMEMORY=1
  fi

  log ""
  if [[ "$SKIP_PONYTAIL" -eq 0 ]]; then
    if confirm "Install/update Ponytail for detected coding agents?" 1; then
      AGENT_HARNESS_NONINTERACTIVE="$NONINTERACTIVE" run_setup_script install-ponytail.sh || warn "Ponytail setup had warnings."
    else
      warn "Ponytail setup skipped."
    fi
  fi

  log ""
  if [[ "$SKIP_CHATGPT_WEB" -eq 0 ]]; then
    log "codex-chatgpt-web is unofficial browser automation. It uses your signed-in ChatGPT account."
    log "Review its security model and OpenAI/workspace policies before enabling Full Harness."
    if confirm "Install/update the codex-chatgpt-web launcher from its upstream release?" 0; then
      AGENT_HARNESS_NONINTERACTIVE="$NONINTERACTIVE" run_setup_script install-chatgpt-web.sh || warn "ChatGPT Web bridge setup had warnings."
    else
      warn "ChatGPT Web bridge setup skipped."
    fi
  fi

  log ""
  if [[ "$SKIP_AGENTMEMORY" -eq 0 ]]; then
    major="$(node_major || echo 0)"
    if [[ "$major" -lt 20 ]] || ! command -v npx >/dev/null 2>&1; then
      warn "Skipping agentmemory because Node.js 20+ with npx is unavailable."
    elif confirm "Set up keyless local agentmemory (no API key)?" 1; then
      AGENT_HARNESS_NONINTERACTIVE="$NONINTERACTIVE" run_setup_script install-agentmemory.sh || warn "agentmemory setup needs attention."
    else
      warn "agentmemory setup skipped."
    fi
  fi

  log ""
  doctor_harness "$TARGET" || true

  cat <<'NEXT'

== One-time actions that cannot be safely automated ==

Codex hooks (if Ponytail and/or agentmemory were installed):
  1. Launch `codex` in a terminal once.
  2. Review the "Hooks need review" prompt and trust only the hooks you accept.
  3. Restart Codex after approval.

ChatGPT Web Full Harness (only if you installed codex-chatgpt-web):
  1. Open the launcher and sign in to ChatGPT in its embedded browser.
  2. Run its browser smoke test and install the ChatGPT Web models.
  3. Open its MCP page, create the tunnel, and follow Full Harness setup.
  4. In ChatGPT Developer Mode, create the requested connector (currently `Codex Native2`).
  5. Restart Codex after model/connector setup.

agentmemory:
  - No LLM API key is required by the harness default.
  - REST/MCP: http://127.0.0.1:3111
  - Viewer:   http://127.0.0.1:3113
  - Local semantic embeddings are enabled; the first semantic request downloads MiniLM once.
  - Codex/Gemini/Antigravity are wired through agentmemory's supported MCP adapters when detected.

Useful checks:
  agent-harness doctor .
  agent-harness memory status
  agent-harness memory doctor

Coding flow:
  1. ChatGPT Web orchestrates through the Codex Full Harness when enabled.
  2. Agents use agentmemory MCP recall only when historical context materially helps.
  3. Use `skill-discovery` for maintained external expertise.
  4. Use `repo-skill-bootstrap` for repository-specific invariants.
  5. Execute via Codex/Antigravity, verify with CI, and save only durable memory.
NEXT
}

doctor_harness() {
  local requested_target="${1:-$TARGET}"
  TARGET="$requested_target"
  resolve_target
  local failed=0

  check() {
    if [[ -e "$TARGET/$1" ]]; then
      echo "OK      $1"
    else
      echo "MISSING $1"
      failed=1
    fi
  }

  check "AGENTS.md"
  check ".agents/skills/repo-skill-bootstrap/SKILL.md"
  check ".agents/skills/skill-discovery/SKILL.md"
  check ".agents/skills/skill-maintenance/SKILL.md"
  check ".agents/skills/shared-memory/SKILL.md"
  check ".github/ISSUE_TEMPLATE/agent-task.md"
  check ".github/pull_request_template.md"
  check "scripts/agents/create-worktree.sh"
  check "docs/agent-orchestrator.md"

  if [[ -x "$TARGET/scripts/agents/create-worktree.sh" ]]; then
    echo "OK      scripts/agents/create-worktree.sh executable"
  else
    echo "INVALID scripts/agents/create-worktree.sh is not executable"
    failed=1
  fi

  log ""
  log "External readiness (informational):"
  command -v codex >/dev/null 2>&1 && ok "codex" || warn "codex not found"
  if command -v codex-chatgpt-web >/dev/null 2>&1; then
    ok "codex-chatgpt-web"
  else
    warn "codex-chatgpt-web CLI not detected (optional; launcher may still be installed)"
  fi

  major="$(node_major || echo 0)"
  if [[ "$major" -ge 20 ]] && command -v npx >/dev/null 2>&1; then
    ok "Node $(node -v) + npx"
  else
    warn "Node.js 20+ with npx not ready for agentmemory"
  fi

  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 2 http://127.0.0.1:3111/agentmemory/livez >/dev/null 2>&1; then
    ok "agentmemory reachable on :3111"
  else
    warn "agentmemory not reachable on :3111 (optional)"
  fi

  if [[ -f "$HOME/.codex/config.toml" ]] && grep -q '^\[mcp_servers\.agentmemory\]' "$HOME/.codex/config.toml"; then
    ok "agentmemory MCP configured for Codex"
  elif command -v codex >/dev/null 2>&1; then
    warn "agentmemory MCP not found in ~/.codex/config.toml"
  fi

  return "$failed"
}

case "$COMMAND" in
  init)
    TARGET="${1:-.}"
    init_harness
    ;;
  ready|setup)
    ready_harness "$@"
    ;;
  doctor)
    TARGET="${1:-.}"
    doctor_harness "$TARGET"
    ;;
  version)
    if [[ -f "$VERSION_FILE" ]]; then
      cat "$VERSION_FILE"
    else
      echo "unknown"
      exit 1
    fi
    ;;
  memory)
    command -v npx >/dev/null 2>&1 || { echo "npx is required" >&2; exit 127; }
    exec npx -y "$AGENTMEMORY_PACKAGE" "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 1
    ;;
esac
